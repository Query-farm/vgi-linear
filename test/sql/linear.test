# A predicate under OR is not pushed; the SDK still filters exactly.
query T
SELECT key FROM linear.main.issues() WHERE key = 'ENG-1' OR assignee = 'alan' ORDER BY key;
----
ENG-1
OPS-3

# filter := adds a raw IssueFilter, ANDed with the pushed WHERE filters.
query T
SELECT key FROM linear.main.issues(filter := '{"estimate": {"gte": 5}}') WHERE team_key = 'ENG' ORDER BY key;
----
ENG-2
ENG-3

statement error
SELECT key FROM linear.main.issues(filter := '[1, 2]');
----
<REGEX>:.*JSON object.*

# Issues UNION across trackers on the shared column names.
query TITTTT
SELECT repo, number, title, state, user_login, html_url FROM linear.main.issues() WHERE key = 'OPS-2';
----
OPS	2	Pager alert noise	open	grace	https://linear.app/acme/issue/OPS-2/pager-alert-noise

# --------------------------------------------------------------- issue_history

query TTTT
SELECT created_at, actor, from_state, to_state FROM linear.main.issue_history(issue_key := 'ENG-1') WHERE is_state_change ORDER BY created_at;
----
2026-10-21 09:00:00+00	grace	NULL	Todo
2026-10-22 10:00:00+00	ada	Todo	In Progress
2026-10-24 16:00:00+00	ada	In Progress	Done

# Cycle time: first started transition → completed transition.
query TR
SELECT issue_key, (epoch_ms(done) - epoch_ms(started)) / 3600000 AS cycle_time_hours FROM (
  SELECT issue_key, min(created_at) FILTER (WHERE to_state_type = 'started') AS started,
         max(created_at) FILTER (WHERE to_state_type = 'completed') AS done
  FROM linear.main.issue_history() WHERE issue_key IN ('ENG-1', 'OPS-1') GROUP BY issue_key) ORDER BY issue_key;
----
ENG-1	54.0
OPS-1	32.0

# = / IN on issue_key reads only those issues (one issue(id:) query each).
query I
SELECT count(*) FROM read_json('{LINEAR_FIXTURE_URL}/__requests') WHERE operation = 'LinearIssueChildren' AND variables LIKE '%"id":"OPS-1"%';
----
1

query TTIITT
SELECT issue_key, to_assignee, from_priority, to_priority, added_labels, removed_labels FROM linear.main.issue_history()
WHERE issue_key IN ('ENG-1', 'ENG-2') AND (to_assignee IS NOT NULL OR to_priority IS NOT NULL OR len(added_labels) > 0) ORDER BY issue_key, created_at;
----
ENG-1	NULL	NULL	NULL	[Bug]	NULL
ENG-1	ada	NULL	NULL	NULL	NULL
ENG-2	NULL	3	2	NULL	NULL

query RR
SELECT from_estimate, to_estimate FROM linear.main.issue_history(issue_key := 'ENG-1') WHERE to_estimate IS NOT NULL;
----
2.0	3.0

# Without keys the scan fans out over issues; team_key narrows the issues listing.
query I
SELECT count(*) FROM linear.main.issue_history() WHERE team_key = 'OPS';
----
4

query T
SELECT variables::JSON->>'$.filter' FROM read_json('{LINEAR_FIXTURE_URL}/__requests') WHERE operation = 'LinearIssueFanout' ORDER BY seq DESC LIMIT 1;
----
{"team":{"key":{"eq":"OPS"}}}

# Small pages: issues whose nested history overflows are continued with issue(id:) queries.
query II
SELECT count(*), count(DISTINCT id) FROM linear.main.issue_history(page_size := 2);
----
15	15

query I
SELECT count(*) FROM linear.main.issue_history(issue_key := 'ENG-404');
----
0

