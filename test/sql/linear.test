ENG-3	started
ENG-4	backlog
ENG-6	unstarted
ENG-7	unstarted

query TT
SELECT variables LIKE '%{"team":{"key":{"eq":"ENG"}}}%', variables LIKE '%{"state":{"type":{"nin":["completed","canceled"]}}}%'
FROM read_json('{LINEAR_FIXTURE_URL}/__requests?root=issues') ORDER BY seq DESC LIMIT 1;
----
true	true

