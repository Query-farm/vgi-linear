statement ok
DROP SECRET linear_admin;

# ------------------------------------------- an OAuth member token: scope feature-detection

statement ok
CREATE SECRET linear_member (TYPE linear, ACCESS_TOKEN 'lin_oauth_member', BASE_URL '{LINEAR_FIXTURE_URL}/graphql');

# Linear refuses User.email for this key: the worker retries without it and returns NULL.
query TT
SELECT display_name, email FROM linear.main.users ORDER BY display_name;
----
ada	NULL
alan	NULL
grace	NULL
kat	NULL

query I
SELECT count(*) FROM linear.main.users WHERE email IS NULL;
----
4

# The audit log needs an admin key: a clear error, not an empty table.
statement error
SELECT count(*) FROM linear.main.audit_entries;
----
<REGEX>:.*admin.*

# Customers are not enabled for this key: zero rows.
query I
SELECT count(*) FROM linear.main.customers;
----
0

query I
SELECT count(*) FROM linear.main.issues();
----
10

statement ok
DROP SECRET linear_member;

# --------------------------------------------------- rate limits, retries, complexity

statement ok
CREATE SECRET linear_rl (TYPE linear, API_KEY 'lin_api_admin', BASE_URL '{LINEAR_FIXTURE_URL}/ratelimited/graphql');

# Every distinct request is answered RATELIMITED once; the worker waits for the reset and retries.
query I
SELECT count(*) FROM linear.main.teams;
----
2

query II
SELECT count(*) FILTER (WHERE error LIKE '%Rate limit%'), count(*) FILTER (WHERE status = 200) FROM read_json('{LINEAR_FIXTURE_URL}/__requests?path=/ratelimited/graphql');
----
1	1

statement ok
DROP SECRET linear_rl;

statement ok
CREATE SECRET linear_flaky (TYPE linear, API_KEY 'lin_api_admin', BASE_URL '{LINEAR_FIXTURE_URL}/flaky/graphql');

query I
SELECT count(*) FROM linear.main.workflow_states;
----
12

query II
SELECT count(*) FILTER (WHERE status = 502), count(*) FILTER (WHERE status = 200) FROM read_json('{LINEAR_FIXTURE_URL}/__requests?path=/flaky/graphql');
----
1	1

statement ok
DROP SECRET linear_flaky;

statement ok
CREATE SECRET linear_strict (TYPE linear, API_KEY 'lin_api_admin', BASE_URL '{LINEAR_FIXTURE_URL}/strict/graphql');

# This endpoint caps complexity at 1500: the worker halves its page size until the query fits.
query II
SELECT count(*), sum(len(labels)) FROM linear.main.issues(page_size := 250);
----
10	11

query I
SELECT count(*) > 0 FROM read_json('{LINEAR_FIXTURE_URL}/__requests?path=/strict/graphql') WHERE error LIKE '%too complex%';
----
true

statement ok
DROP SECRET linear_strict;

# ------------------------------------------------------------- strictness checks

# Every query the worker sent validated against the vendored Linear schema.
query I
SELECT count(*) FROM read_json('{LINEAR_FIXTURE_URL}/__requests?invalid=1') WHERE seq > 0;
----
0

# And none of them was a mutation.
query I
SELECT count(*) FROM read_json('{LINEAR_FIXTURE_URL}/__requests') WHERE query ILIKE '%mutation%';
----
0
