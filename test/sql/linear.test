# name: test/sql/linear.test
# description: SQL tests for the linear worker against the offline Linear GraphQL server (test/mock_api/server.ts)
# group: [linear]

require vgi

require-env LINEAR_WORKER

require-env LINEAR_FIXTURE_URL

# httpfs + json read the mock server's /__requests log to assert what was pushed down.
statement ok
LOAD httpfs;

statement ok
LOAD json;

statement ok
ATTACH 'linear' (TYPE vgi, LOCATION '{LINEAR_WORKER}');

# ---------------------------------------------------------------- secret errors

statement error
SELECT count(*) FROM linear.main.issues();
----
<REGEX>:.*no linear secret.*

statement ok
CREATE SECRET linear_bad (TYPE linear, API_KEY 'lin_api_wrong', BASE_URL '{LINEAR_FIXTURE_URL}/graphql');

statement error
SELECT count(*) FROM linear.main.issues();
----
<REGEX>:.*HTTP 400.*AUTHENTICATION_ERROR.*

statement ok
DROP SECRET linear_bad;

statement ok
CREATE SECRET linear_insecure (TYPE linear, API_KEY 'x', BASE_URL 'http://api.example.com/graphql');

statement error
SELECT count(*) FROM linear.main.teams;
----
<REGEX>:.*https.*

statement ok
DROP SECRET linear_insecure;

statement ok
CREATE SECRET linear_admin (TYPE linear, API_KEY 'lin_api_admin', BASE_URL '{LINEAR_FIXTURE_URL}/graphql');

# ------------------------------------------------------------------------ issues

# Archived issues (ENG-8) are left out unless asked for, as in the Linear app.
query TTTTT
SELECT key, repo, title, state, status FROM linear.main.issues() ORDER BY key;
----
ENG-1	ENG	Login page crashes on Safari	closed	Done
ENG-2	ENG	Add SSO with SAML	open	In Progress
ENG-3	ENG	Slow dashboard queries	open	In Review
ENG-4	ENG	Dark mode	open	Backlog
ENG-5	ENG	Safari login error	closed	Duplicate
ENG-6	ENG	Upgrade Node runtime	open	Todo
ENG-7	ENG	SAML metadata endpoint	open	Todo
OPS-1	OPS	Rotate TLS certificates	closed	Done
OPS-2	OPS	Pager alert noise	open	Triage
OPS-3	OPS	Backup restore drill	open	In Progress

query IT
SELECT count(*), max(key) FILTER (WHERE archived_at IS NOT NULL) FROM linear.main.issues(include_archived := true);
----
11	ENG-8

# Several pages: the relay cursor carries across batches.
query II
SELECT count(*), count(DISTINCT key) FROM linear.main.issues(page_size := 3);
----
10	10

query I
SELECT count(*) FROM read_json('{LINEAR_FIXTURE_URL}/__requests?root=issues') WHERE variables LIKE '%"first":3,%';
----
4

# Ordered by updatedAt (Linear's orderBy), newest first.
query T
SELECT query LIKE '%orderBy: updatedAt%' FROM read_json('{LINEAR_FIXTURE_URL}/__requests?root=issues') ORDER BY seq DESC LIMIT 1;
----
true

# Typed, tracker-aligned columns.
query TITTTTTTTT
SELECT key, number, team_key, assignee, assignees, user_login, list_sort(labels), priority_label, estimate, due_date
FROM linear.main.issues() WHERE key IN ('ENG-2', 'ENG-4') ORDER BY key;
----
ENG-2	2	ENG	grace	[grace]	ada	[API, Feature]	High	5.0	2026-11-28
ENG-4	4	ENG	NULL	[]	kat	[Feature]	Low	NULL	NULL

query TTTTTT
SELECT key, created_at, started_at, completed_at, canceled_at, closed_at FROM linear.main.issues() WHERE key IN ('ENG-1', 'ENG-5') ORDER BY key;
----
ENG-1	2026-10-21 09:00:00+00	2026-10-22 10:00:00+00	2026-10-24 16:00:00+00	NULL	2026-10-24 16:00:00+00
ENG-5	2026-10-22 08:00:00+00	NULL	NULL	2026-10-23 09:00:00+00	2026-10-23 09:00:00+00

query TTTT
SELECT project, project_milestone, cycle_number, html_url FROM linear.main.issues() WHERE key = 'ENG-1';
----
Apollo	Alpha	41	https://linear.app/acme/issue/ENG-1/login-page-crashes-on-safari

# key = / IN uses Linear's identifier-aware id comparator; projection keeps the selection small.
query T
SELECT title FROM linear.main.issues() WHERE key = 'OPS-1';
----
Rotate TLS certificates

query TTT
SELECT variables::JSON->>'$.filter', query LIKE '%labels%', query LIKE '%description%' FROM read_json('{LINEAR_FIXTURE_URL}/__requests?root=issues') ORDER BY seq DESC LIMIT 1;
----
{"id":{"eq":"OPS-1"}}	false	false

query T
SELECT key FROM linear.main.issues() WHERE key IN ('ENG-3', 'OPS-2', 'NOPE-9') ORDER BY key;
----
ENG-3
OPS-2

query T
SELECT variables::JSON->>'$.filter' FROM read_json('{LINEAR_FIXTURE_URL}/__requests?root=issues') ORDER BY seq DESC LIMIT 1;
----
{"id":{"in":["ENG-3","OPS-2","NOPE-9"]}}

# Team + 'open' state become one IssueFilter (state types, GitHub vocabulary).
query TT
SELECT key, status_type FROM linear.main.issues() WHERE team_key = 'ENG' AND state = 'open' ORDER BY key;
----
