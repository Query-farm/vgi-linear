ENG-2	2
ENG-3	2
ENG-7	2
OPS-1	1

query T
SELECT variables LIKE '%"priority":{"gte":1}%' AND variables LIKE '%"priority":{"lte":2}%' FROM read_json('{LINEAR_FIXTURE_URL}/__requests?root=issues') ORDER BY seq DESC LIMIT 1;
