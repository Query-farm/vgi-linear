{"createdAt":{"gte":"2026-11-06T00:00:00.000Z"}}

# closed_at = coalesce(completed_at, canceled_at): a range is "either one in range".
query T
SELECT key FROM linear.main.issues() WHERE closed_at >= TIMESTAMPTZ '2026-10-24 00:00:00+00' ORDER BY key;
----
ENG-1
OPS-1

query T
SELECT variables::JSON->>'$.filter' FROM read_json('{LINEAR_FIXTURE_URL}/__requests?root=issues') ORDER BY seq DESC LIMIT 1;
----
{"or":[{"completedAt":{"gte":"2026-10-24T00:00:00.000Z"}},{"canceledAt":{"gte":"2026-10-24T00:00:00.000Z"}}]}

query T
SELECT key FROM linear.main.issues() WHERE completed_at IS NOT NULL ORDER BY key;
----
ENG-1
OPS-1

